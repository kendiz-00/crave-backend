# CRAVE Backend Environment Variables - Production

# Application
NODE_ENV=production
PAYMENT_MODE=live
PUBLIC_API_URL=https://crave-backend-oie3.onrender.com
PORT=4000

# Database (Render PostgreSQL Production)
DATABASE_URL="postgresql://crave_user:password@crave-db-prod-postgres.render.com:5432/crave_db"

# JWT Configuration (GENERATE STRONG SECRETS FOR PRODUCTION)
JWT_SECRET="production-jwt-secret-key-min-32-characters-long-use-openssl-rand-base64-32"
JWT_REFRESH_SECRET="production-refresh-secret-key-min-32-characters-long-use-openssl-rand-base64-32"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Paystack Configuration (Production Keys)
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# CORS Configuration (Production Frontend)
CORS_ALLOWED_ORIGINS="https://crave.com,https://www.crave.com"
CLIENT_URL="https://crave.com"

# Rate Limiting (Stricter for production)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cache Configuration
CACHE_TTL=300000

# Logging
LOG_LEVEL=warn
# SMS Configuration (CRAVE uses BulkClix for production OTP delivery)
SMS_PROVIDER=bulkclix
BULKCLIX_API_KEY=your_bulkclix_api_key
BULKCLIX_SENDER_ID=CRAVE
# Alternative Provider (Africa's Talking):
# SMS_PROVIDER=africas_talking
# AFRICAS_TALKING_USERNAME=your_username
# AFRICAS_TALKING_API_KEY=your_api_key
