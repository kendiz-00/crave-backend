# CRAVE Backend Environment Variables - Staging

# Application
NODE_ENV=staging
PORT=4000

# Database (Render PostgreSQL Staging)
DATABASE_URL="postgresql://crave_user:password@crave-db-staging-postgres.render.com:5432/crave_db_staging"

# JWT Configuration
JWT_SECRET="staging-jwt-secret-key-min-32-characters-long"
JWT_REFRESH_SECRET="staging-refresh-secret-key-min-32-characters-long"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Paystack Configuration (Sandbox)
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# CORS Configuration (Staging Frontend)
CORS_ALLOWED_ORIGINS="https://crave-staging.vercel.app,https://crave-frontend.vercel.app"
CLIENT_URL="https://crave-staging.vercel.app"

# Rate Limiting (More lenient for staging)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Cache Configuration
CACHE_TTL=300000

# Logging
LOG_LEVEL=debug
