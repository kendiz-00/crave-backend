# Template only. Configure actual values in the isolated Render staging service.
NODE_ENV=staging
PAYMENT_MODE=test
PUBLIC_API_URL=https://crave-backend-staging.onrender.com
PORT=4000

# Use the INTERNAL connection URL of the separately provisioned crave-db-staging database.
DATABASE_URL=postgresql://STAGING_DB_USER:REPLACE_WITH_PASSWORD@STAGING_DB_HOSTNAME:5432/crave_db_staging?sslmode=require

# Generate separate random secrets for this service; never reuse production values.
JWT_SECRET=REPLACE_WITH_RANDOM_32_CHARACTER_STAGING_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_32_CHARACTER_STAGING_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Obtain both credentials from Paystack TEST MODE only.
PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_WITH_TEST_PUBLIC_KEY
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_TEST_SECRET_KEY
SMS_PROVIDER=africas_talking
AFRICAS_TALKING_USERNAME=your_username
AFRICAS_TALKING_API_KEY=your_api_key

# Only the assigned Vercel staging origin; do not add production domains.
CORS_ALLOWED_ORIGINS=https://crave-staging.vercel.app
CLIENT_URL=https://crave-staging.vercel.app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
CACHE_TTL=300000
LOG_LEVEL=debug
