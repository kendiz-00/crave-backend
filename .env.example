# CRAVE Backend Environment Variables

# Application
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/crave?schema=public"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-min-32-characters-long"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-characters-long"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Paystack Configuration
PAYSTACK_PUBLIC_KEY=test
PAYSTACK_SECRET_KEY=test
PAYSTACK_WEBHOOK_SECRET=test

# CORS Configuration
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
CLIENT_URL="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cache Configuration
CACHE_TTL=300000

# Logging
LOG_LEVEL=info

# WhatsApp Configuration (Optional)
WHATSAPP_NUMBER=233550020788
